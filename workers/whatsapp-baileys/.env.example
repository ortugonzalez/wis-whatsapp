# Worker env (VM only, chmod 600). Never commit real values.
# SUPABASE_URL must match NEXT_PUBLIC_SUPABASE_URL of the panel.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# One sector per VM/process (ADR 005). REQUIRED — no silent default.
# Contable VM: contable. Técnico: eq-tecnico-centros. Tesorería: tesoreria.
SECTOR_SLUG=contable
# Auth dir must be unique per sector (never share between two workers).
WHATSAPP_AUTH_DIR=/home/soporte/apps/whatsapp-ui/workers/whatsapp-baileys/auth
# S33: safety poll default 120s (was 90). Idle uses worker_peek_pending.
# WORKER_SAFETY_POLL_MS=120000

# Tras S20: campañas usan pull a cobranzas; estos env = fallback si el pull falla.
# WA_PACING_DELAY_MIN_MS=50000
# WA_PACING_DELAY_MAX_MS=90000
# WA_PACING_HORA_INICIO=9
# WA_PACING_HORA_FIN=13
# WA_PACING_MAX_MSGS_DIA=80
# WA_PACING_CIRCUIT_429_MIN=30
# WA_PACING_CLAIM_LIMIT=1
# WA_PACING_TZ=America/Argentina/Buenos_Aires
# Fuente de verdad: /app/config/wa-politica en cobranzas (mismo secreto que Vercel).
# COBRANZAS_SITE_URL=https://YOUR_COBRANZAS_HOST
# WA_POLITICA_WORKER_SECRET=
# WA_POLITICA_CACHE_MS=60000
