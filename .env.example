# Panel (Vercel / local) — only publishable keys; never service_role in client
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3010
WIS_OUTBOUND_ENABLED=false

# Server-only (API routes / auth callback cleanup). Not for the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Optional Cloud API provider (panel server only). Never in browser.
# CLOUD_API_KEY=
# CLOUD_PHONE_NUMBER_ID=
# CLOUD_WEBHOOK_SECRET=

# Worker Baileys (VM env file only — chmod 600; not for Vercel browser)
# SUPABASE_URL must match NEXT_PUBLIC_SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY=
# WHATSAPP_AUTH_DIR=
# BAILEYS_LOG_LEVEL=silent
# SECTOR_SLUG=your-sector-slug  # REQUIRED — one sector per VM/process
